+						if (g_signal_handler_find(menu_shell, G_SIGNAL_MATCH_FUNC, 0, 0, NULL,
+						                          on_menu_item_inserted, NULL) == 0)
+							g_signal_connect_after(menu_shell, "insert", G_CALLBACK(on_menu_item_inserted), NULL);
+					}
 				}
 
